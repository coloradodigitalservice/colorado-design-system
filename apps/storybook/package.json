{
  "name": "@cods-internal/storybook",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coloradodigitalservice/colorado-design-system.git",
    "directory": "apps/storybook"
  },
  "scripts": {
    "validate": "node ../../scripts/check-workspace.mjs --workspace apps/storybook && pnpm typecheck",
    "dev": "storybook dev --host 127.0.0.1 -p 6006 --exact-port --no-open",
    "build": "pnpm --filter @coloradodigitalservice/colorado-design-system build && storybook build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coloradodigitalservice/colorado-design-system": "workspace:*",
    "@coloradodigitalservice/colorado-design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/html-vite": "10.6.1",
    "storybook": "10.6.1"
  }
}
