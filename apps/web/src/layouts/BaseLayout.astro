---
import { getCollection } from 'astro:content';
import '@coloradodigitalservice/colorado-design-tokens/tokens.css';
import '@coloradodigitalservice/colorado-design-system/styles.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  landing?: boolean;
}

const { title, description, landing = false } = Astro.props;
const docs = (await getCollection('docs')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.startsWith(baseUrl)
  ? `/${Astro.url.pathname.slice(baseUrl.length)}`
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Colorado Design System</title>
  </head>
  <body>
    <a class="cods-docs-skip-link" href="#main-content">
      Skip to main content
    </a>
    <SiteHeader pathname={pathname} />
    {landing ? (
      <main id="main-content" class="cods-docs-main" tabindex="-1">
        <slot />
      </main>
    ) : (
      <div class="cods-docs-container cods-docs-grid">
        <nav class="cods-docs-nav" aria-label="Documentation">
          <p class="cods-docs-nav-title">Documentation</p>
          <ul>
            <li>
              <a
                href={baseUrl}
                aria-current={pathname === '/' ? 'page' : undefined}
              >
                Overview
              </a>
            </li>
            {docs.map((entry) => (
              <li>
                <a
                  href={`${baseUrl}${entry.id}/`}
                  aria-current={
                    pathname === `/${entry.id}/` ? 'page' : undefined
                  }
                >
                  {entry.data.navLabel}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <main id="main-content" class="cods-docs-main" tabindex="-1">
          <slot />
        </main>
      </div>
    )}
    <SiteFooter />
  </body>
</html>
