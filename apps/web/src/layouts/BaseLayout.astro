---
import { getCollection } from 'astro:content';
import '@coloradodigitalservice/colorado-design-tokens/tokens.css';
import '@coloradodigitalservice/colorado-design-system/styles.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
  landing?: boolean;
}

const { title, description, headings = [], landing = false } = Astro.props;
const docs = (await getCollection('docs')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.startsWith(baseUrl)
  ? `/${Astro.url.pathname.slice(baseUrl.length)}`
  : Astro.url.pathname;
const foundationIds = [
  'color',
  'elevation',
  'focus-states',
  'grids-spacing',
  'icon',
  'logos',
  'radius',
  'typography',
];
const currentId = pathname.replace(/^\/+|\/+$/g, '');
const section = foundationIds.includes(currentId)
  ? 'Foundations'
  : currentId !== 'getting-started' &&
      docs.some((entry) => entry.id === currentId)
    ? 'Components'
    : 'Documentation';
const sectionDocs = docs.filter((entry) => {
  if (section === 'Foundations') return foundationIds.includes(entry.id);
  if (section === 'Components')
    return !foundationIds.includes(entry.id) && entry.id !== 'getting-started';
  return true;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Colorado Design System</title>
  </head>
  <body>
    <a class="cods-docs-skip-link" href="#main-content">
      Skip to main content
    </a>
    <SiteHeader pathname={pathname} />
    <div
      class:list={[
        'cods-docs-container',
        'cods-docs-grid',
        {
          'cods-docs-grid--landing': landing,
          'cods-docs-grid--with-toc':
            section === 'Components' && headings.length >= 2,
        },
      ]}
    >
      {!landing && (
        <nav class="cods-docs-nav" aria-label="Documentation">
          <p class="cods-docs-nav-title">{section}</p>
          <ul class="usa-sidenav">
            {section === 'Documentation' && (
              <li class="usa-sidenav__item">
                <a
                  href={baseUrl}
                  class:list={[{ 'usa-current': pathname === '/' }]}
                  aria-current={pathname === '/' ? 'page' : undefined}
                >
                  Overview
                </a>
              </li>
            )}
            {sectionDocs.map((entry) => (
              <li class="usa-sidenav__item">
                <a
                  href={`${baseUrl}${entry.id}/`}
                  class:list={[{ 'usa-current': pathname === `/${entry.id}/` }]}
                  aria-current={
                    pathname === `/${entry.id}/` ? 'page' : undefined
                  }
                >
                  {entry.data.navLabel}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <main id="main-content" class="cods-docs-main" tabindex="-1">
        <slot />
      </main>
      {section === 'Components' && headings.length >= 2 && (
        <nav
          class="usa-in-page-nav cods-in-page-navigation cods-docs-toc"
          aria-label="On this page"
          data-cods-in-page-navigation
        >
          <p class="usa-in-page-nav__heading cods-in-page-navigation__heading">
            On this page
          </p>
          <ul class="usa-in-page-nav__list cods-in-page-navigation__list">
            {headings.map((heading) => (
              <li class="usa-in-page-nav__item cods-in-page-navigation__item">
                <a
                  class="usa-in-page-nav__link cods-in-page-navigation__link"
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
    <SiteFooter />
  </body>
</html>

<script>
  import { initAllInPageNavigation } from '@coloradodigitalservice/colorado-design-system';
  initAllInPageNavigation();
</script>
