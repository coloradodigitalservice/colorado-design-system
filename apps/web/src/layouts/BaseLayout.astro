---
import { getCollection } from 'astro:content';
import '@coloradodigitalservice/colorado-design-tokens/tokens.css';
import '@coloradodigitalservice/colorado-design-system/styles.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
  landing?: boolean;
}

const { title, description, headings = [], landing = false } = Astro.props;
const docs = (await getCollection('docs')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.startsWith(baseUrl)
  ? `/${Astro.url.pathname.slice(baseUrl.length)}`
  : Astro.url.pathname;
const currentId = pathname.replace(/^\/+|\/+$/g, '');
const currentDoc = docs.find((entry) => entry.id === currentId);
const section =
  currentId === 'getting-started' ? undefined : currentDoc?.data.section;
const sectionDocs = section
  ? docs
      .filter(
        (entry) =>
          entry.data.section === section && entry.id !== 'getting-started',
      )
      .sort((a, b) => a.data.navLabel.localeCompare(b.data.navLabel))
  : docs;
const inPageHeadings = section === 'component' ? headings : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Colorado Design System</title>
  </head>
  <body>
    <a class="cods-docs-skip-link" href="#main-content">
      Skip to main content
    </a>
    <SiteHeader pathname={pathname} />
    {landing ? (
      <main id="main-content" class="cods-docs-main" tabindex="-1">
        <slot />
      </main>
    ) : (
      <div
        class:list={[
          'cods-docs-container',
          'cods-docs-grid',
          { 'cods-docs-grid--with-toc': inPageHeadings.length >= 2 },
        ]}
      >
        <nav class="cods-docs-nav" aria-label="Documentation">
          <details data-cods-docs-sidebar>
            <summary class="cods-docs-nav-title">
              <span class="cods-docs-nav-browse">Browse </span>
              <span>
                {section === 'foundation'
                  ? 'Foundations'
                  : section === 'component'
                    ? 'Components'
                    : 'Documentation'}
              </span>
            </summary>
            <ul class="usa-sidenav">
              {!section && (
                <li>
                  <a
                    href={baseUrl}
                    aria-current={pathname === '/' ? 'page' : undefined}
                  >
                    Overview
                  </a>
                </li>
              )}
              {sectionDocs.map((entry) => (
                <li class="usa-sidenav__item">
                  <a
                    href={`${baseUrl}${entry.id}/`}
                    class:list={[
                      { 'usa-current': pathname === `/${entry.id}/` },
                    ]}
                    aria-current={
                      pathname === `/${entry.id}/` ? 'page' : undefined
                    }
                  >
                    {entry.data.navLabel}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
        <main id="main-content" class="cods-docs-main" tabindex="-1">
          <slot />
        </main>
        {inPageHeadings.length >= 2 && (
          <nav
            class="usa-in-page-nav cods-in-page-navigation cods-docs-toc"
            aria-label="Page sections"
            data-cods-in-page-navigation
          >
            <p class="usa-in-page-nav__heading cods-in-page-navigation__heading">
              On this page
            </p>
            <ul class="usa-in-page-nav__list cods-in-page-navigation__list">
              {inPageHeadings.map((heading) => (
                <li class="usa-in-page-nav__item cods-in-page-navigation__item">
                  <a
                    class="usa-in-page-nav__link cods-in-page-navigation__link"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    )}
    <SiteFooter />
  </body>
</html>

<script>
  import { initInPageNavigation } from '@coloradodigitalservice/colorado-design-system';
  const sidebar = document.querySelector<HTMLDetailsElement>(
    '[data-cods-docs-sidebar]',
  );
  const desktop = window.matchMedia('(min-width: 48rem)');
  if (sidebar) {
    const setSidebar = () => {
      sidebar.open = desktop.matches;
    };
    setSidebar();
    desktop.addEventListener('change', setSidebar);
  }
  const navigation = document.querySelector<HTMLElement>('.cods-docs-toc');
  if (navigation) {
    for (const link of navigation.querySelectorAll<HTMLAnchorElement>(
      'a[href^="#"]',
    )) {
      const heading = document.getElementById(
        decodeURIComponent(link.hash.slice(1)),
      );
      if (!(heading instanceof HTMLHeadingElement) || heading.tagName !== 'H2')
        continue;
      const section = document.createElement('section');
      section.id = heading.id;
      heading.removeAttribute('id');
      heading.before(section);
      section.append(heading);
      while (
        section.nextElementSibling &&
        section.nextElementSibling.tagName !== 'H2'
      ) {
        section.append(section.nextElementSibling);
      }
    }
    initInPageNavigation(navigation);
  }
</script>
