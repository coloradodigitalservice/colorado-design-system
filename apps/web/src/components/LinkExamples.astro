---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/link.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/link.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Inline' },
    { state: 'standalone', label: 'Standalone' },
    { state: 'inline-small', label: 'Inline small' },
    { state: 'inline-large', label: 'Inline large' },
    { state: 'standalone-small', label: 'Standalone small' },
    { state: 'more-link', label: 'Standalone with arrow' },
    { state: 'prefix-icon', label: 'Prefix icon' },
    { state: 'external', label: 'External link in a new tab' },
    { state: 'disabled', label: 'Disabled' },
  ]}
/>
