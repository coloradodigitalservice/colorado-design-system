---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/language-selector.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/language-selector.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Two languages (default)' },
    { state: 'multiple-languages', label: 'Multiple languages' },
  ]}
/>

<script>
  import { initAllLanguageSelector } from '@coloradodigitalservice/colorado-design-system';
  initAllLanguageSelector();
</script>
