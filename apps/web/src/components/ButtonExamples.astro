---
import examples from '@coloradodigitalservice/colorado-design-system/examples/button.json';
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/button.json';
import spriteUrl from '@coloradodigitalservice/colorado-design-system/icons/sprite.svg?url';
import ComponentPreview from './ComponentPreview.astro';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  spriteUrl={spriteUrl}
  variants={[
    { state: 'default', label: 'Primary' },
    { state: 'secondary', label: 'Secondary' },
    { state: 'danger', label: 'Danger' },
    { state: 'slim', label: 'Slim' },
    { state: 'icon-only', label: 'Icon only' },
    { state: 'primary-medium-icon-both', label: 'With decorative icons' },
    { state: 'link', label: 'Navigation link' },
  ]}
/>
