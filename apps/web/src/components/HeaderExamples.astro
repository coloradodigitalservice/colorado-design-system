---
import examples from '@coloradodigitalservice/colorado-design-system/examples/header.json';
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/header.json';
import CodeExamples from './CodeExamples.astro';

const previewUrl = `${import.meta.env.BASE_URL}header/preview/`;
---

<section
  class="cods-docs-header-preview"
  data-cods-docs-preview="header"
  aria-labelledby="header-preview-heading"
>
  <h2 id="header-preview-heading">Component preview</h2>
  <p>
    This site's own header, at the top of the page, is the live wide-screen
    example. The narrow-screen preview below loads in its own frame because a
    page supports one Header. Select Menu in it to open the drawer.
  </p>
  <iframe
    class="cods-docs-header-preview__frame cods-docs-header-preview__frame--narrow"
    src={previewUrl}
    title="Header preview, narrow screen"
    width="375"
    height="480"
    loading="lazy"
  ></iframe>
</section>
<CodeExamples metadata={metadata} examples={examples.examples} />

<style>
  .cods-docs-header-preview {
    margin-block: var(--cods-space-lg);
  }

  .cods-docs-header-preview__frame {
    border: var(--cods-border-divider-width) solid
      var(--cods-color-border-subtle);
    display: block;
    inline-size: 100%;
    max-inline-size: 100%;
  }

  .cods-docs-header-preview__frame--narrow {
    inline-size: 375px;
  }
</style>
