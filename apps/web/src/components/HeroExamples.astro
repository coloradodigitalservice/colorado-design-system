---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/hero.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/hero.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  imageBase={import.meta.env.BASE_URL}
  variants={[
    { state: 'with-image', label: 'Light image' },
    { state: 'dark-image', label: 'Dark image' },
    { state: 'default', label: 'Light banner' },
    { state: 'dark-banner', label: 'Dark banner with breadcrumb and eyebrow' },
  ]}
/>
