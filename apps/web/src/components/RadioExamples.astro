---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/radio.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/radio.json';
import spriteUrl from '@coloradodigitalservice/colorado-design-system/icons/sprite.svg?url';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  spriteUrl={spriteUrl}
  variants={[
    { state: 'default', label: 'Default' },
    { state: 'selected', label: 'Selected' },
    { state: 'disabled', label: 'Disabled option' },
    { state: 'disabled-group', label: 'Disabled group' },
    { state: 'error', label: 'Error' },
    { state: 'tile', label: 'Tile' },
    { state: 'tile-error', label: 'Tile error' },
  ]}
/>
