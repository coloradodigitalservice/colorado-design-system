---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/videos.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/videos.json';
import CodeExamples from './CodeExamples.astro';
---

{examples.examples.map((example) => (
  <section aria-label={`${example.state} video`}>
    <h3>
      {example.state === 'default'
        ? 'Native video'
        : example.state === 'embed'
          ? 'Embedded video'
          : '4:3 video'}
    </h3>
    <div
      set:html={example.html.replaceAll(
        '/videos/',
        `${import.meta.env.BASE_URL.replace(/\/$/, '')}/videos/`,
      )}
    />
  </section>
))}
<CodeExamples metadata={metadata} examples={examples.examples} />
