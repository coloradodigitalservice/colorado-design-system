---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/videos.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/videos.json';
import ComponentPreview from './ComponentPreview.astro';

// The fixture's sample media lives at /videos/; prefix the site base path so
// the preview plays under a project base path. The code block keeps the
// canonical fixture paths.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (markup: string) =>
  markup.replaceAll('"/videos/', `"${base}/videos/`);
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Native video (default)' },
    { state: 'embed', label: 'Embedded player' },
    { state: 'four-three', label: '4:3' },
  ]}
  previewHtml={withBase}
/>
