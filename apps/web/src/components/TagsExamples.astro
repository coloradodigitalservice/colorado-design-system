---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/tags.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/tags.json';
import CodeExamples from './CodeExamples.astro';
---

<h3>In context</h3>
<div>
  <h4>
    Sales tax increases to 2.2%{' '}
    <span class="usa-tag cods-tags cods-tags--blue">Update</span>
  </h4>
  <p>Read about the updated statewide sales tax rate.</p>
</div>
<h3>Colors and long content</h3>
{examples.examples.map((example) => (
  <section aria-label={`${example.state} tag`}>
    <h4>{example.state === 'default' ? 'Default (gray)' : example.state}</h4>
    <div set:html={example.html} />
  </section>
))}
<CodeExamples metadata={metadata} examples={examples.examples} />
