---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/tags.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/tags.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Gray (default)' },
    { state: 'blue', label: 'Blue' },
    { state: 'green', label: 'Green' },
    { state: 'red', label: 'Red' },
    { state: 'yellow', label: 'Yellow' },
    { state: 'plum', label: 'Plum' },
    { state: 'teal', label: 'Teal' },
  ]}
/>
