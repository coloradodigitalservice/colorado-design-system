---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/tooltip.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/tooltip.json';
import ComponentPreview from './ComponentPreview.astro';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'top', label: 'Top' },
    { state: 'bottom', label: 'Bottom' },
    { state: 'left', label: 'Left' },
    { state: 'right', label: 'Right' },
    { state: 'light', label: 'Light' },
  ]}
/>

<script>
  import { initAllTooltip } from '@coloradodigitalservice/colorado-design-system';
  initAllTooltip();
</script>
