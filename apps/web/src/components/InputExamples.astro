---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/input.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/input.json';
import spriteUrl from '@coloradodigitalservice/colorado-design-system/icons/sprite.svg?url';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  spriteUrl={spriteUrl}
  variants={[
    { state: 'default', label: 'Default (Medium)' },
    { state: 'required', label: 'Required' },
    { state: 'error', label: 'Error' },
    { state: 'success', label: 'Success' },
    { state: 'email', label: 'Email' },
    { state: 'number', label: 'Number' },
    { state: 'small', label: 'Small' },
    { state: 'disabled', label: 'Disabled' },
    { state: 'readonly', label: 'Read-only' },
    { state: 'large', label: 'Large' },
    { state: 'icons', label: 'Decorative icons' },
    { state: 'large-icons', label: 'Large with icons' },
  ]}
/>
