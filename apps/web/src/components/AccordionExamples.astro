---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/accordion.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/accordion.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Bordered (default)' },
    { state: 'borderless', label: 'Borderless' },
    { state: 'white', label: 'White' },
  ]}
/>

<script>
  import { initAllAccordions } from '@coloradodigitalservice/colorado-design-system';
  initAllAccordions();
</script>
