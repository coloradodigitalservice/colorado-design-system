---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/in-page-alert.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/in-page-alert.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'info', label: 'Info' },
    { state: 'success', label: 'Success' },
    { state: 'warning', label: 'Warning' },
    { state: 'urgent', label: 'Urgent' },
    { state: 'without-heading', label: 'Without heading' },
    { state: 'info-no-icon', label: 'Without icon' },
  ]}
/>
