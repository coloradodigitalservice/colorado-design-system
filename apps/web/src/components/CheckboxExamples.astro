---
import metadata from '@coloradodigitalservice/colorado-design-system/metadata/checkbox.json';
import examples from '@coloradodigitalservice/colorado-design-system/examples/checkbox.json';
import ComponentPreview from './ComponentPreview.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
---

<ComponentPreview
  displayName={metadata.displayName}
  examples={examples.examples}
  variants={[
    { state: 'default', label: 'Default' },
    { state: 'checked', label: 'Checked' },
    { state: 'indeterminate', label: 'Indeterminate' },
    { state: 'disabled', label: 'Disabled' },
    { state: 'disabled-checked', label: 'Disabled checked' },
    { state: 'error', label: 'Error' },
    { state: 'grouped', label: 'Group' },
    { state: 'card', label: 'Card' },
    { state: 'card-checked', label: 'Card checked' },
    { state: 'card-indeterminate', label: 'Card indeterminate' },
    { state: 'card-disabled', label: 'Card disabled' },
    { state: 'card-disabled-checked', label: 'Card disabled checked' },
  ]}
/>
<script>
  document
    .querySelectorAll<HTMLInputElement>(
      '#checkbox-indeterminate, #checkbox-card-indeterminate',
    )
    .forEach((input) => {
      input.indeterminate = true;
    });
</script>
