---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '@coloradodigitalservice/colorado-design-system/styles.css';
import InPageAlertExamples from '../components/InPageAlertExamples.astro';
import SiteAlertExamples from '../components/SiteAlertExamples.astro';
import CheckboxExamples from '../components/CheckboxExamples.astro';
import ButtonExamples from '../components/ButtonExamples.astro';
import AccordionExamples from '../components/AccordionExamples.astro';
import BreadcrumbsExamples from '../components/BreadcrumbsExamples.astro';
import SelectExamples from '../components/SelectExamples.astro';
import RadioExamples from '../components/RadioExamples.astro';
import ComboBoxExamples from '../components/ComboBoxExamples.astro';
import CardExamples from '../components/CardExamples.astro';
import LinkExamples from '../components/LinkExamples.astro';
import DividerExamples from '../components/DividerExamples.astro';
import ComponentSummary from '../components/ComponentSummary.astro';
import IconExamples from '../components/IconExamples.astro';
import InputExamples from '../components/InputExamples.astro';
import IconListExamples from '../components/IconListExamples.astro';
import HeroExamples from '../components/HeroExamples.astro';
import VideosExamples from '../components/VideosExamples.astro';
import TagsExamples from '../components/TagsExamples.astro';
import SearchExamples from '../components/SearchExamples.astro';
import ProcessListExamples from '../components/ProcessListExamples.astro';
import TooltipExamples from '../components/TooltipExamples.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="cods-docs-content">
    <h1>{entry.data.title}</h1>
    {entry.id === 'site-alert' && (
      <>
        <p>
          Site Alert communicates a sitewide service update or emergency. Its
          maturity is <strong>experimental</strong> in the <code>0.x</code>{' '}
          development series.
        </p>
        <SiteAlertExamples mode="default" />
      </>
    )}
    {entry.id === 'button' && <ButtonExamples mode="default" />}
    {entry.id === 'accordion' && (
      <>
        <p>
          Accordion shows and hides related sections of content. Its maturity is{' '}
          <strong>experimental</strong> in the <code>0.x</code> development
          series.
        </p>
        <AccordionExamples />
      </>
    )}
    {entry.id === 'breadcrumbs' && <BreadcrumbsExamples />}
    {entry.id === 'tooltip' && (
      <>
        <TooltipExamples />
        <ComponentSummary component="tooltip" figma={entry.data.figma} />
      </>
    )}
    {entry.id === 'radio' && <RadioExamples />}
    {entry.id === 'combo-box' && <ComboBoxExamples />}
    {entry.id === 'input' && (
      <>
        {' '}
        <h2>Examples</h2>
        <InputExamples />
        <ComponentSummary component="input" figma={entry.data.figma} />
      </>
    )}
    {entry.id === 'card' && <CardExamples />}
    {entry.id === 'card-default' && <CardExamples variant="default" />}
    {entry.id === 'card-icon' && <CardExamples variant="icon" />}
    {entry.id === 'icon-list' && (
      <>
        <h2>Examples</h2>
        <IconListExamples />
        <ComponentSummary component="icon-list" figma={entry.data.figma} />
      </>
    )}
    {entry.id === 'checkbox' && <CheckboxExamples />}
    {entry.id === 'link' && <LinkExamples />}
    {entry.id === 'divider' && <DividerExamples />}
    {(entry.id === 'videos' ||
      entry.id === 'tags' ||
      entry.id === 'card' ||
      entry.id === 'hero' ||
      entry.id === 'radio' ||
      entry.id === 'site-alert' ||
      entry.id === 'accordion' ||
      entry.id === 'breadcrumbs' ||
      entry.id === 'link' ||
      entry.id === 'checkbox' ||
      entry.id === 'combo-box' ||
      entry.id === 'select' ||
      entry.id === 'divider' ||
      entry.id === 'process-list') && (
      <ComponentSummary component={entry.id} figma={entry.data.figma} />
    )}
    {entry.id === 'in-page-alert' && (
      <>
        <InPageAlertExamples mode="default" />
        <ComponentSummary component="in-page-alert" figma={entry.data.figma} />
      </>
    )}
    <Content />
    {entry.id === 'search' && <SearchExamples />}
    {entry.id === 'hero' && <HeroExamples />}
    {entry.id === 'tags' && <TagsExamples />}
    {entry.id === 'videos' && <VideosExamples />}
    {entry.id === 'process-list' && <ProcessListExamples />}
    {entry.id === 'select' && <SelectExamples />}
    {entry.id === 'in-page-alert' && <InPageAlertExamples mode="remaining" />}
    {entry.id === 'button' && <ButtonExamples mode="remaining" />}
    {entry.id === 'icon' && <IconExamples />}
    {entry.id === 'site-alert' && <SiteAlertExamples mode="remaining" />}
  </article>
</BaseLayout>
