---
// Loaded only inside the Header documentation iframes. USWDS's header
// behavior supports one header per document, and the documentation site
// already has one, so the live preview needs its own document.
import fixture from '@coloradodigitalservice/colorado-design-system/fixtures/header.html?raw';
import logoUrl from '@coloradodigitalservice/colorado-design-system/logos/cods-logo.svg?url';
import spriteUrl from '@coloradodigitalservice/colorado-design-system/icons/sprite.svg?url';
import '@coloradodigitalservice/colorado-design-tokens/tokens.css';
import '@coloradodigitalservice/colorado-design-system/styles.css';

// `/header/preview/` shows the default state; `/header/preview/full/` shows
// the header with search, languages, a dropdown, and mega menus.
export function getStaticPaths() {
  return [{ params: { state: undefined } }, { params: { state: 'full' } }];
}

const state = Astro.params.state ?? 'default';
const block = new RegExp(
  `<div data-cods-header-fixture="${state}"[^>]*>([\\s\\S]*?<\\/header>)`,
).exec(fixture);
if (!block) throw new Error(`Missing Header fixture state: ${state}`);
const preview = block[1]
  .replaceAll('/icons/sprite.svg', spriteUrl)
  .replaceAll('/logos/cods-logo.svg', logoUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Header preview | Colorado Design System</title>
  </head>
  <body>
    <Fragment set:html={preview} />
    <script>
      import {
        initAllHeaders,
        initAllLanguageSelector,
      } from '@coloradodigitalservice/colorado-design-system';
      initAllHeaders();
      initAllLanguageSelector();
      // Examples don't navigate or run searches.
      document.addEventListener('submit', (event) => event.preventDefault());
      document.addEventListener('click', (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest('a[href="#"]')
        )
          event.preventDefault();
      });
    </script>
  </body>
</html>
