---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Overview"
  description="Documentation for the Colorado Design System."
>
  <h1>Colorado Design System</h1>
  <p>
    Guidance and examples for building consistent, accessible Colorado digital
    services.
  </p>
  <p>
    <a href={`${import.meta.env.BASE_URL}getting-started/`}>
      Explore the getting started page.
    </a>
  </p>
  <h2>Components</h2>
  <ul>
    <li>
      <a href={`${import.meta.env.BASE_URL}accordion/`}>Accordion</a>: related
      collapsible sections.
    </li>
    <li>
      <a href={`${import.meta.env.BASE_URL}site-alert/`}>Site Alert</a>: a
      static sitewide notice.
    </li>
    <li>
      <a href={`${import.meta.env.BASE_URL}footer/`}>Footer</a>: full or compact
      site navigation.
    </li>
    <li>
      <a href={`${import.meta.env.BASE_URL}icon/`}>Icon</a>: Phosphor Regular
      icons and usage guidance.
    </li>
  </ul>
</BaseLayout>
