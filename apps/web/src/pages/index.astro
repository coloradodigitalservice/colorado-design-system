---
import BaseLayout from '../layouts/BaseLayout.astro';
const draft =
  'Eu tellus adipiscing risus ultrices sit justo in congue ante amet morbi leo in facilisis egestas at diam nec porttitor sed at augue semper lectus sed adipiscing tristique sagittis convallis ultricies facilisi amet malesuada tellus molestie aenean sit pharetra nulla ac nunc purus eu lectus id quam amet eu etiam tellus cum quis massa consectetur vitae gravida risus magna tempus.';
const highlights = [
  { title: 'Colorado Department of Revenue', status: 'Now Live' },
  { title: 'Colorado Tax Division', status: 'Launching Soon' },
  { title: 'Colorado DMV', status: 'Launching Soon' },
];
---

<BaseLayout
  landing
  title="Home"
  description="The Colorado State Design System helps agencies build consistent digital services."
>
  <div class="cods-hero">
    <div class="cods-hero__content">
      <h1 class="cods-hero__heading">Colorado State Design System</h1>
      <p class="cods-hero__intro">
        The Colorado State Design System is an ecosystem of tools that empower
        state agencies to build simple, accessible, and consistent digital
        services for all Coloradans.
      </p>
    </div>
  </div>
  <div class="grid-container">
    <p>
      Key resources:{' '}
      <a href="https://www.figma.com/design/jQ3EiYqe3uEvFbid5ewc41/Colorado-Design-System">
        Figma Kit →
      </a>{' '}
      <a href="https://github.com/coloradodigitalservice/colorado-design-system">
        Github →
      </a>
    </p>
    <hr class="cods-divider" />
    <section aria-labelledby="sites-built">
      <h2 id="sites-built">Sites Built with Colorado Design System</h2>
      <ul class="usa-card-group cods-card-group">
        {highlights.map((item) => (
          <li class="usa-card cods-card tablet:grid-col-4">
            <div class="usa-card__container cods-card__container">
              <div class="usa-card__header cods-card__header">
                <h3 class="usa-card__heading cods-card__heading">
                  {item.title}
                </h3>
              </div>
              <div class="usa-card__body cods-card__body">
                <p>{item.status}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
    <hr class="cods-divider" />
    <section aria-labelledby="getting-started">
      <h2 id="getting-started">Getting Started</h2>
      <div class="grid-row grid-gap">
        <div class="tablet:grid-col-6">
          <h3>For Developers</h3>
          <p>{draft}</p>
        </div>
        <div class="tablet:grid-col-6">
          <h3>For Designers</h3>
          <p>{draft}</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
