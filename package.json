{
  "name": "colorado-design-system-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cods-internal/web dev",
    "check:workspace": "node scripts/check-workspace.mjs --repo",
    "validate": "turbo run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.astro",
    "lint:styles": "stylelint \"{apps,packages,examples}/**/*.{css,scss}\"",
    "lint": "pnpm lint:js && pnpm lint:styles",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "pnpm tokens:check && turbo run build",
    "check": "pnpm check:workspace && pnpm validate && pnpm tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "tokens:validate": "pnpm --filter @coloradodigitalservice/colorado-design-tokens tokens:validate",
    "tokens:build": "pnpm --filter @coloradodigitalservice/colorado-design-tokens build",
    "tokens:check": "turbo run tokens:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "turbo": "2.10.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.1",
    "vitest": "5.0.1"
  }
}
