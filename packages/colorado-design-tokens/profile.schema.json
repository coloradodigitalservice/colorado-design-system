{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoDS DTCG 2025.10 initial project profile",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$type", "$value", "$extensions"],
          "properties": {
            "$type": {
              "enum": [
                "color",
                "dimension",
                "fontFamily",
                "fontWeight",
                "number"
              ]
            },
            "$value": {},
            "$description": {
              "type": "string"
            },
            "$extensions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["org.colorado.source"],
              "properties": {
                "org.colorado.source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "location"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "$type": {
                    "const": "color"
                  }
                }
              },
              "then": {
                "properties": {
                  "$value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[a-z0-9-]+\\.[a-z0-9-]+\\}$"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["colorSpace", "components", "alpha"],
                        "properties": {
                          "colorSpace": {
                            "const": "srgb"
                          },
                          "components": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "alpha": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "$type": {
                    "const": "dimension"
                  }
                }
              },
              "then": {
                "properties": {
                  "$value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[a-z0-9-]+\\.[a-z0-9-]+\\}$"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["value", "unit"],
                        "properties": {
                          "value": {
                            "type": "number"
                          },
                          "unit": {
                            "enum": ["px", "rem"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "$type": {
                    "const": "fontFamily"
                  }
                }
              },
              "then": {
                "properties": {
                  "$value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[a-z0-9-]+\\.[a-z0-9-]+\\}$"
                      },
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^{}\\n\\r]+$"
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[^{}\\n\\r]+$"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "$type": {
                    "const": "fontWeight"
                  }
                }
              },
              "then": {
                "properties": {
                  "$value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[a-z0-9-]+\\.[a-z0-9-]+\\}$"
                      },
                      {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 1000
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "$type": {
                    "const": "number"
                  }
                }
              },
              "then": {
                "properties": {
                  "$value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[a-z0-9-]+\\.[a-z0-9-]+\\}$"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
