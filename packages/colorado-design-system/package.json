{
  "name": "@coloradodigitalservice/colorado-design-system",
  "version": "0.2.7",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coloradodigitalservice/colorado-design-system.git",
    "directory": "packages/colorado-design-system"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/colorado-design-system.mjs"
    },
    "./styles.css": {
      "default": "./dist/colorado-design-system.css"
    },
    "./styles": {
      "default": "./dist/colorado-design-system.css"
    },
    "./package.json": "./package.json",
    "./fixtures/*.html": {
      "default": "./dist/fixtures/*.html"
    },
    "./metadata/*.json": {
      "default": "./dist/metadata/*.json"
    },
    "./examples/*.json": {
      "default": "./dist/examples/*.json"
    },
    "./icons/*.svg": {
      "default": "./dist/icons/*.svg"
    },
    "./icons/catalog.json": {
      "default": "./dist/icons/catalog.json"
    },
    "./icons/LICENSE": {
      "default": "./dist/icons/LICENSE"
    }
  },
  "scripts": {
    "validate": "node ../../scripts/check-workspace.mjs --workspace packages/colorado-design-system",
    "build": "pnpm icons:check && vite build",
    "icons:build": "node ./build/icons.mjs",
    "icons:check": "node ./build/icons.mjs --check",
    "build:watch": "vite build --watch"
  },
  "dependencies": {
    "@coloradodigitalservice/colorado-design-tokens": "workspace:*",
    "@uswds/uswds": "3.14.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1"
  }
}
