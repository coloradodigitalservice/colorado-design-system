{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "config/**",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "scripts/**"
  ],
  "tasks": {
    "validate": {
      "dependsOn": ["^validate"],
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "validate"],
      "outputs": ["dist/**"]
    },
    "tokens:check": {
      "cache": false,
      "outputs": []
    },
    "@coloradodigitalservice/colorado-design-tokens#build": {
      "dependsOn": ["validate"],
      "outputs": ["generated/**"]
    },
    "@cods-internal/storybook#build": {
      "dependsOn": ["^build", "validate"],
      "outputs": ["storybook-static/**"]
    }
  }
}
